# Copy to `.env` and set the password. `.env` is git-ignored.
#
#   cp .env.example .env
#   # then edit POSTGRES_PASSWORD
#   docker compose up --build
#
# There are no secrets in this file: it documents the variables only.

# Password for the PostgreSQL role. REQUIRED — compose refuses to start without it.
POSTGRES_PASSWORD=change-me-please

# Optional. Defaults shown.
POSTGRES_USER=ironnote
POSTGRES_DB=ironnote

# Host port for the web UI. Everything else stays on the internal network.
APP_PORT=8080

# IANA timezone used to bucket workouts by month in statistics.
# History itself is always stored as absolute instants (UTC).
APP_TIMEZONE=Europe/Moscow

# debug | info | warn | error
LOG_LEVEL=info

# Leave empty in production (same-origin through nginx).
# For local development against Vite, use: http://localhost:5173
CORS_ALLOWED_ORIGINS=
