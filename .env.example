# IronNote configuration.
#
#   cp .env.example .env
#   # set the password and a LONG admin password, then:
#   docker compose up --build
#
# This file documents variables only. Never commit real values.

# --- database ---------------------------------------------------------------
# REQUIRED. Use a long random value, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=change-me-please
POSTGRES_USER=ironnote
POSTGRES_DB=ironnote

# --- bootstrap administrator -----------------------------------------------
# Created only when the users table is empty. After that the .env value is
# ignored, so changing it later does not reset the real password.
#
# REQUIRED. At least 12 characters, letters plus digits/symbols, and not a
# placeholder: the server refuses to start with a weak value unless you set
# IRONNOTE_REQUIRE_STRONG_ADMIN_PASSWORD=false (local machine only).
IRONNOTE_ADMIN_USERNAME=admin
IRONNOTE_ADMIN_PASSWORD=change-me-to-a-long-unique-password-1
IRONNOTE_REQUIRE_STRONG_ADMIN_PASSWORD=true

# --- transport / deployment -------------------------------------------------
# Host port for the web UI. Bound to 127.0.0.1 by default so nothing is exposed
# before TLS is configured in front (see README "Публикация в интернет").
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Set to true once TLS terminates in front of the app. Marks session cookies
# Secure and enables HSTS.
IRONNOTE_COOKIE_SECURE=false

# Canonical external origin, e.g. https://gym.example.com.
#
# Optional. State-changing requests are validated by comparing the browser's
# Origin header with the host the request arrived at, so a normal same-origin
# install works without setting this. Set it when a proxy rewrites Host to an
# internal name, or to pin one exact origin.
IRONNOTE_PUBLIC_ORIGIN=

# CIDRs whose X-Forwarded-For may be trusted (your TLS proxy). Empty = trust none,
# which is correct when the API is not behind a proxy.
# With the bundled compose stack, nginx is the proxy: 172.16.0.0/12 covers the
# compose network.
IRONNOTE_TRUSTED_PROXIES=172.16.0.0/12

# --- application ------------------------------------------------------------
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=info
LOG_FORMAT=json

# Empty in production: the UI and API share an origin through nginx.
CORS_ALLOWED_ORIGINS=
